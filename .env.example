# ============================================================
# PROSPECTOR ATLAS GR — Environment Variables
# ============================================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env no repositório.
# ============================================================

# ── Aplicação ────────────────────────────────────────────────
NODE_ENV=
PORT=

# Origens permitidas pelo CORS (separadas por vírgula)
ALLOWED_ORIGINS=

# ── Banco de Dados ───────────────────────────────────────────
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=
REDIS_PASSWORD=
REDIS_PORT=

# ── Autenticação ─────────────────────────────────────────────
# Use um segredo forte: openssl rand -base64 64
JWT_SECRET=
BETTER_AUTH_SECRET=

# ── IA / LLM ─────────────────────────────────────────────────
GEMINI_API_KEY=
LITELLM_URL=
LITELLM_KEY=
LITELLM_PORT=

# ── Busca (Meilisearch) ───────────────────────────────────────
MEILI_HOST=
# Use um segredo forte: openssl rand -base64 32
MEILI_MASTER_KEY=
MEILI_PORT=

# ── Storage (MinIO / S3-compatible) ──────────────────────────
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
STORAGE_BUCKET=
MINIO_PORT=
MINIO_CONSOLE_PORT=

# ── Observabilidade ──────────────────────────────────────────
PROMETHEUS_PORT=
GRAFANA_PORT=
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
LOKI_PORT=
# URL do OTLP exporter (Jaeger, Grafana Tempo, etc.)
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Integrações externas ──────────────────────────────────────
APOLLO_API_KEY=
GOOGLE_MAPS_API_KEY=
HUNTER_API_KEY=

# ── App URL ───────────────────────────────────────────────────
APP_URL=
