# ============================================================
# PROSPECTOR ATLAS GR — Environment Variables
# ============================================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env no repositório.
# ============================================================

# ── Aplicação ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Origens permitidas pelo CORS (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Banco de Dados ───────────────────────────────────────────
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://prospector:CHANGE_ME_DB_PASS@localhost:5434/prospectordb?schema=public
POSTGRES_USER=prospector
POSTGRES_PASSWORD=CHANGE_ME_DB_PASS
POSTGRES_DB=prospectordb
POSTGRES_PORT=5434

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME_REDIS_PASS@localhost:6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASS
REDIS_PORT=6379

# ── Autenticação ─────────────────────────────────────────────
# Use um segredo forte: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_64
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_64

# ── IA / LLM ─────────────────────────────────────────────────
GEMINI_API_KEY=CHANGE_ME_YOUR_GEMINI_KEY
LITELLM_URL=http://localhost:4000/v1
LITELLM_KEY=CHANGE_ME_LITELLM_MASTER_KEY
LITELLM_PORT=4000

# ── Busca (Meilisearch) ───────────────────────────────────────
MEILI_HOST=http://localhost:7700
# Use um segredo forte: openssl rand -base64 32
MEILI_MASTER_KEY=CHANGE_ME_MEILI_MASTER_KEY
MEILI_PORT=7700

# ── Storage (MinIO / S3-compatible) ──────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
STORAGE_BUCKET=prospector-assets
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Observabilidade ──────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASS
LOKI_PORT=3100
# URL do OTLP exporter (Jaeger, Grafana Tempo, etc.)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── Integrações externas ──────────────────────────────────────
APOLLO_API_KEY=CHANGE_ME_APOLLO_KEY
GOOGLE_MAPS_API_KEY=CHANGE_ME_GOOGLE_MAPS_KEY
HUNTER_API_KEY=CHANGE_ME_HUNTER_KEY

# ── App URL ───────────────────────────────────────────────────
APP_URL=http://localhost:3000
