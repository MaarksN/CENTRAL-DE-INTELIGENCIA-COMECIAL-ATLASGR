generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum CompanyStatus {
  Ativo
  Inativo
  Em_analise @map("Em análise")
}

enum ContactStatus {
  Ativo
  Inativo
}

enum LeadStatus {
  Novo_Lead        @map("Novo Lead")
  Qualificacao     @map("Qualificação")
  Primeiro_Contato @map("Primeiro Contato")
  Diagnostico      @map("Diagnóstico")
  Proposta
  Negociacao       @map("Negociação")
  Fechado_Ganho    @map("Fechado Ganho")
  Fechado_Perdido  @map("Fechado Perdido")
}

enum LeadTemperature {
  Frio
  Morno
  Quente
}

enum ActivityType {
  Ligacao   @map("Ligação")
  WhatsApp
  Email     @map("E-mail")
  Reuniao   @map("Reunião")
  Follow_up @map("Follow-up")
  Visita
  Tarefa
}

enum ActivityStatus {
  Pendente
  Em_andamento @map("Em andamento")
  Concluida    @map("Concluída")
  Cancelada
}

model Company {
  id                String        @id @default(cuid())
  legalName         String
  tradeName         String
  cnpj              String?
  stateRegistration String?
  segment           String?
  cnae              String?
  size              String?
  employeeCount     Int?
  estimatedRevenue  Float?
  website           String?
  linkedin          String?
  instagram         String?
  phones            String[]
  emails            String[]
  address           String?
  city              String?
  state             String?
  zipCode           String?
  owner             String?
  status            CompanyStatus @default(Ativo)
  tags              String[]
  observations      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Enrichment (Receita Federal / BrasilAPI + heurísticas)
  situacaoCadastral String?
  naturezaJuridica  String?
  capitalSocial     Float?
  dataAbertura      DateTime?
  qsa               Json?
  enrichmentStatus  String    @default("Pendente") // Pendente | Enriquecendo | Enriquecido | Falhou
  enrichmentSource  String?
  enrichedAt        DateTime?

  contacts       Contact[]
  leads          Lead[]
  enrichmentLogs EnrichmentLog[]
  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([cnpj])
  @@index([legalName])
}

model EnrichmentLog {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source    String // BrasilAPI-CNPJ | BrasilAPI-CEP | AI-Estimate | Domain-Heuristic
  field     String // o que foi enriquecido (ex: "dados-cadastrais", "endereco", "contatos-sugeridos")
  status    String // success | not_found | failed
  rawData   Json?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
}

model Contact {
  id           String        @id @default(cuid())
  name         String
  role         String?
  department   String?
  phone        String?
  whatsapp     String?
  email        String?
  linkedin     String?
  birthDate    DateTime?
  observations String?
  status       ContactStatus @default(Ativo)

  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leads          Lead[]
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model Lead {
  id String @id @default(cuid())

  // New CRM fields
  status          LeadStatus       @default(Novo_Lead)
  source          String?
  channel         String?
  temperature     LeadTemperature?
  score           Int?
  owner           String?
  lastInteraction DateTime?
  nextAction      DateTime?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  activities     Activity[]
  timeline       TimelineEvent[]
  internalNotes  Note[]
  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
}

model Activity {
  id           String         @id @default(cuid())
  type         ActivityType
  owner        String
  date         DateTime
  time         String?
  status       ActivityStatus @default(Pendente)
  observations String?

  leadId         String
  lead           Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model TimelineEvent {
  id          String @id @default(cuid())
  type        String // creation, edition, movement, activity, comment, generic
  description String

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Note {
  id      String @id @default(cuid())
  content String // Rich text
  author  String

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  actorId   String?
  tenantId  String?
  ipAddress String?
  details   String?  @db.Text
  timestamp DateTime @default(now())

  @@index([tenantId, entity, action])
  @@index([actorId, timestamp])
}

model User {
  id             String       @id @default(cuid())
  name           String
  email          String       @unique
  passwordHash   String
  role           String       @default("VISUALIZADOR")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Organization {
  id         String     @id @default(cuid())
  name       String     @unique
  users      User[]
  companies  Company[]
  contacts   Contact[]
  leads      Lead[]
  activities Activity[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}
