generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
model Lead {
  id        String   @id @default(cuid())
  name      String
  segment   String
  size      String
  location  String
  status    String   @default("Prospect")
  fitScore  Int?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
